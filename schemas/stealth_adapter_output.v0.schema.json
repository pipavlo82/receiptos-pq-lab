{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://receiptos-pq-lab.local/schemas/stealth_adapter_output.v0.schema.json",
  "title": "Stealth Adapter Output v0",
  "type": "object",
  "required": [
    "valid",
    "reason_code",
    "checks",
    "fail_path",
    "details",
    "receipt",
    "receiptHash",
    "eventRoot"
  ],
  "properties": {
    "valid": { "type": "boolean" },
    "reason_code": { "type": "string" },
    "checks": {
      "type": "object",
      "required": ["schema", "receipt_hash", "event_root", "scope", "commands", "diff_commitment"],
      "properties": {
        "schema": { "type": "boolean" },
        "receipt_hash": { "type": "boolean" },
        "event_root": { "type": "boolean" },
        "scope": { "type": "boolean" },
        "commands": { "type": "boolean" },
        "diff_commitment": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "fail_path": {
      "anyOf": [
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "details": {
      "type": "object",
      "required": ["source", "transcript"],
      "properties": {
        "source": { "type": "string" },
        "transcript": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["seq", "type", "prev_hash", "event_hash"],
            "properties": {
              "seq": { "type": "integer", "minimum": 1 },
              "type": { "type": "string", "enum": ["command", "change"] },
              "command": { "type": "object" },
              "change": { "type": "object" },
              "prev_hash": { "type": "string" },
              "event_hash": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "receipt": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "source",
            "transactionId",
            "directory",
            "task",
            "agent",
            "scope",
            "changed",
            "metadata",
            "eventRoot",
            "receiptHash"
          ]
        },
        { "type": "null" }
      ]
    },
    "receiptHash": {
      "anyOf": [
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "eventRoot": {
      "anyOf": [
        { "type": "string" },
        { "type": "null" }
      ]
    }
  },
  "additionalProperties": false
}
