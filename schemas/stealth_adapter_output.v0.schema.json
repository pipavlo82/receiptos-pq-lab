{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://receiptos-pq-lab.local/schemas/stealth_adapter_output.v0.schema.json",
  "title": "Stealth Adapter Output v0",
  "type": "object",
  "required": [
    "valid",
    "reason_code",
    "checks",
    "fail_path",
    "details",
    "receipt",
    "receiptHash",
    "eventRoot",
    "trust"
  ],
  "properties": {
    "valid": { "type": "boolean" },
    "reason_code": {
      "type": "string",
      "enum": [
        "OK",
        "MISSING_REQUIRED_FIELD",
        "BAD_SCHEMA",
        "EMPTY_TRANSCRIPT",
        "DIFF_MISMATCH",
        "TAMPER",
        "CHAIN_MISMATCH",
        "ADAPTER_INTERNAL_ERROR"
      ]
    },
    "checks": {
      "type": "object",
      "required": ["schema", "receipt_hash", "event_root", "scope", "commands", "diff_commitment", "signature_present", "key_id_present", "signed_fields_match", "signature_valid", "signer_allowed", "trust_block_valid"],
      "properties": {
        "schema": { "type": "boolean" },
        "receipt_hash": { "type": "boolean" },
        "event_root": { "type": "boolean" },
        "scope": { "type": "boolean" },
        "commands": { "type": "boolean" },
        "diff_commitment": { "type": "boolean" },
        "signature_present": { "type": "boolean" },
        "key_id_present": { "type": "boolean" },
        "signed_fields_match": { "type": "boolean" },
        "signature_valid": { "type": "boolean" },
        "signer_allowed": { "type": "boolean" },
        "trust_block_valid": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "fail_path": {
      "anyOf": [
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "details": {
      "type": "object",
      "required": ["source", "transcript"],
      "properties": {
        "source": { "type": "string" },
        "transcript": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["seq", "type", "prev_hash", "event_hash"],
            "properties": {
              "seq": { "type": "integer", "minimum": 1 },
              "type": { "type": "string", "enum": ["command", "change"] },
              "command": { "type": "object" },
              "change": { "type": "object" },
              "prev_hash": { "type": "string" },
              "event_hash": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "receipt": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "source",
            "transactionId",
            "directory",
            "task",
            "agent",
            "scope",
            "changed",
            "metadata",
            "eventRoot",
            "receiptHash",
            "trust"
          ]
        },
        { "type": "null" }
      ]
    },
    "receiptHash": {
      "anyOf": [
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "eventRoot": {
      "anyOf": [
        { "type": "string" },
        { "type": "null" }
      ]
    },
    "trust": {
      "anyOf": [
        {
          "type": "object",
          "required": ["signer_id", "key_id", "algorithm", "signed_fields", "signature", "trust_mode"],
          "properties": {
            "signer_id": { "type": "string" },
            "key_id": { "type": "string" },
            "algorithm": { "type": "string" },
            "signed_fields": {
              "type": "array",
              "items": { "type": "string" }
            },
            "signature": { "type": "string" },
            "trust_mode": { "type": "string" }
          },
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    }
  },
  "additionalProperties": false
}
